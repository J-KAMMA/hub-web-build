          { "t": "code", "v": "code" },
          { "t": "text", "v": "と" },
          { "t": "link", "href": "https://example.com/a", "external": true, "c": [{ "t": "text", "v": "Hub" }] },
          { "t": "text", "v": "と" },
          { "t": "link", "href": "/v2/articles/x", "external": false, "c": [{ "t": "text", "v": "内部" }] }
