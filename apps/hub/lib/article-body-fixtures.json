      { "kind": "paragraph", "text": "<img src=x onerror=alert(1)>", "inline": [{ "t": "text", "v": "<img src=x onerror=alert(1)>" }] }
    ]
  },
  {
    "name": "空の本文",
    "input": "\n\n   \n",
    "expected": []
